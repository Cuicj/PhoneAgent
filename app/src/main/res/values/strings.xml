    <!-- 相机功能：暗光检测 -->
    <string name="home_camera_title">相机</string>
    <string name="home_camera_desc">用摄像头在暗光下观察红外亮点，帮助寻找隐藏摄像头。</string>
    <string name="home_camera_link">查看相机功能 ›</string>
    <string name="title_camera">相机</string>
    <string name="title_camera_detector">暗光检测</string>
    <string name="camera_home_title">暗光检测</string>
    <string name="camera_home_intro">用手机后置摄像头观察暗处的红外亮点，帮助寻找隐藏摄像头；这是相机传感器的特性，不依赖红外发射器。</string>
    <string name="camera_detector_entry">打开暗光检测 ›</string>
    <string name="camera_detector_entry_desc">进入全屏相机预览，可调节增益与对比度，增强暗处亮点。</string>
    <string name="camera_hidden_title">寻找隐藏摄像头</string>
    <string name="camera_hidden_desc">关灯后用相机缓慢扫描房间、插座、烟雾报警器与正对床铺的摆件，隐藏摄像头的红外补光会呈现紫白色亮点。</string>
    <string name="camera_principle_title">原理说明</string>
    <string name="camera_principle_desc">多数手机摄像头能捕捉人眼看不到的红外光，暗环境下红外补光更明显，因此可在屏幕中看到亮点；部分机型红外滤镜较强，可能看不到。</string>
    <string name="camera_detector_steps">使用步骤：关灯或调暗环境 → 缓慢扫描房间 → 观察屏幕中的紫白色亮点 → 靠近确认是否为摄像头。</string>
    <string name="camera_detector_dark_hint">关灯模式：暗环境下红外亮点更明显</string>
    <string name="camera_detector_misjudge">误判提示：反光、指示灯、烟雾报警器指示灯也会出现亮点，请靠近确认；部分手机摄像头对红外不敏感，可能看不到。</string>
    <string name="camera_detector_permission_title">需要相机权限</string>
    <string name="camera_detector_permission_desc">暗光检测需要使用后置摄像头观察红外亮点，画面只在本地实时处理，不会保存或上传。</string>
    <string name="camera_detector_grant">授予相机权限</string>
    <string name="camera_detector_gain">增益 %1$.1fx</string>
    <string name="camera_detector_contrast">对比度 %1$.1fx</string>
